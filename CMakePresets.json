{
  "version": 3,
  "cmakeMinimumRequired": {"major": 3, "minor": 22, "patch": 0},
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {"KSTONE_WERROR": "ON"}
    },
    {"name": "debug", "inherits": "base", "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug", "BUILD_SHARED_LIBS": "ON"}},
    {"name": "release", "inherits": "base", "cacheVariables": {"CMAKE_BUILD_TYPE": "Release"}},
    {"name": "asan", "inherits": "base",
     "cacheVariables": {"CMAKE_BUILD_TYPE": "RelWithDebInfo", "KSTONE_SANITIZE": "address"}},
    {"name": "tsan", "inherits": "base",
     "cacheVariables": {"CMAKE_BUILD_TYPE": "RelWithDebInfo", "KSTONE_SANITIZE": "thread"}}
  ],
  "buildPresets": [
    {"name": "debug", "configurePreset": "debug"},
    {"name": "release", "configurePreset": "release"},
    {"name": "asan", "configurePreset": "asan"},
    {"name": "tsan", "configurePreset": "tsan"}
  ],
  "testPresets": [
    {"name": "base", "hidden": true, "output": {"outputOnFailure": true}, "execution": {"noTestsAction": "error"}},
    {"name": "debug", "inherits": "base", "configurePreset": "debug"},
    {"name": "release", "inherits": "base", "configurePreset": "release"},
    {"name": "asan", "inherits": "base", "configurePreset": "asan",
     "environment": {"ASAN_OPTIONS": "detect_leaks=1:abort_on_error=1", "UBSAN_OPTIONS": "print_stacktrace=1"}},
    {"name": "tsan", "inherits": "base", "configurePreset": "tsan",
     "environment": {"TSAN_OPTIONS": "halt_on_error=1"}}
  ]
}
