<?xml version="1.0"?>
<!-- Free-floating body with a 4-joint arm (e.g. a space manipulator).
     base_link is the root; load with RootJoint::free_flyer. -->
<robot name="floating_base">
  <link name="base_link">
    <inertial>
      <mass value="20" />
      <inertia ixx="0.5" ixy="0" ixz="0" iyy="0.6" iyz="0" izz="0.7" />
    </inertial>
  </link>

  <link name="link1">
    <inertial>
      <mass value="1.0" />
      <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.002" />
    </inertial>
  </link>
  <joint name="joint1" type="revolute">
    <parent link="base_link" />
    <child link="link1" />
    <origin xyz="0.25 0 0.15" />
    <axis xyz="0 0 1" />
    <limit lower="-3.0" upper="3.0" effort="50" velocity="2" />
  </joint>

  <link name="link2">
    <inertial>
      <origin xyz="0.15 0 0" />
      <mass value="1.0" />
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.008" iyz="0" izz="0.008" />
    </inertial>
  </link>
  <joint name="joint2" type="revolute">
    <parent link="link1" />
    <child link="link2" />
    <origin xyz="0 0 0.08" />
    <axis xyz="0 -1 0" />
    <limit lower="-1.8" upper="1.8" effort="50" velocity="2" />
  </joint>

  <link name="link3">
    <inertial>
      <origin xyz="0.12 0 0" />
      <mass value="0.6" />
      <inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.003" iyz="0" izz="0.003" />
    </inertial>
  </link>
  <joint name="joint3" type="revolute">
    <parent link="link2" />
    <child link="link3" />
    <origin xyz="0.30 0 0" />
    <axis xyz="0 -1 0" />
    <limit lower="-2.4" upper="2.4" effort="30" velocity="2" />
  </joint>

  <link name="link4">
    <inertial>
      <mass value="0.3" />
      <inertia ixx="0.0003" ixy="0" ixz="0" iyy="0.0003" iyz="0" izz="0.0003" />
    </inertial>
  </link>
  <joint name="joint4" type="revolute">
    <parent link="link3" />
    <child link="link4" />
    <origin xyz="0.25 0 0" />
    <axis xyz="1 0 0" />
    <limit lower="-3.0" upper="3.0" effort="10" velocity="3" />
  </joint>

  <link name="tool" />
  <joint name="tool_joint" type="fixed">
    <parent link="link4" />
    <child link="tool" />
    <origin xyz="0.10 0 0" />
  </joint>
</robot>
