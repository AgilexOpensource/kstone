<?xml version="1.0"?>
<!-- Test arm: revolute, continuous and prismatic joints, a fixed tool frame and a mimic gripper. -->
<robot name="test_arm">
  <link name="base_link">
    <inertial><origin xyz="0 0 0.05"/><mass value="2.0"/><inertia ixx="0.01" iyy="0.01" izz="0.01" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <link name="link1">
    <inertial><origin xyz="0 0 0.1"/><mass value="1.0"/><inertia ixx="0.01" iyy="0.01" izz="0.01" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <link name="link2">
    <inertial><origin xyz="0.15 0 0"/><mass value="0.8"/><inertia ixx="0.01" iyy="0.01" izz="0.01" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <link name="link3">
    <inertial><origin xyz="0.1 0 0"/><mass value="0.5"/><inertia ixx="0.005" iyy="0.005" izz="0.005" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <link name="link4">
    <inertial><origin xyz="0.05 0 0"/><mass value="0.3"/><inertia ixx="0.002" iyy="0.002" izz="0.002" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <link name="tool"/>
  <link name="finger_left">
    <inertial><mass value="0.1"/><inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <link name="finger_right">
    <inertial><mass value="0.1"/><inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>

  <joint name="j1" type="revolute">
    <parent link="base_link"/><child link="link1"/>
    <origin xyz="0 0 0.1"/><axis xyz="0 0 1"/>
    <limit lower="-2.0" upper="2.0" velocity="1.5" effort="10"/>
  </joint>
  <joint name="j2" type="revolute">
    <parent link="link1"/><child link="link2"/>
    <origin xyz="0 0 0.2"/><axis xyz="0 1 0"/>
    <limit lower="-1.5" upper="1.5" velocity="1.2" effort="8"/>
  </joint>
  <joint name="j3" type="continuous">
    <parent link="link2"/><child link="link3"/>
    <origin xyz="0.3 0 0"/><axis xyz="1 0 0"/>
    <limit velocity="2.0" effort="5"/>
  </joint>
  <joint name="j4" type="prismatic">
    <parent link="link3"/><child link="link4"/>
    <origin xyz="0.2 0 0"/><axis xyz="1 0 0"/>
    <limit lower="0.0" upper="0.1" velocity="0.5" effort="50"/>
  </joint>
  <joint name="tool_joint" type="fixed">
    <parent link="link4"/><child link="tool"/>
    <origin xyz="0.1 0.02 0" rpy="0 0 0.3"/>
  </joint>
  <joint name="finger_left_joint" type="prismatic">
    <parent link="tool"/><child link="finger_left"/>
    <axis xyz="0 1 0"/>
    <limit lower="0.0" upper="0.04" velocity="0.2" effort="20"/>
  </joint>
  <joint name="finger_right_joint" type="prismatic">
    <parent link="tool"/><child link="finger_right"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.04" upper="0.0" velocity="0.2" effort="20"/>
    <mimic joint="finger_left_joint" multiplier="-1.0" offset="0.0"/>
  </joint>
</robot>
